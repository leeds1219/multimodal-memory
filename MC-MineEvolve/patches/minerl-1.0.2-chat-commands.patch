+    private static final String[] LANDMARK_SUFFIXES = {"_log", "_ore", "crafting_table", "furnace", "water", "lava"};
+    private static final int LANDMARK_RADIUS = 16, LANDMARK_HEIGHT = 8, LANDMARK_KEEP = 3;
+
+    public static JsonObject getNearbyBlocksJson() {
+        Minecraft mc = Minecraft.getInstance();
+        JsonObject out = new JsonObject();
+        net.minecraft.util.math.BlockPos me = mc.player.getPosition();
+        // per landmark name: up to LANDMARK_KEEP nearest [x, y, z, dist]
+        java.util.Map<String, java.util.List<double[]>> best = new java.util.HashMap<>();
+        net.minecraft.util.math.BlockPos.Mutable pos = new net.minecraft.util.math.BlockPos.Mutable();
+        for (int dx = -LANDMARK_RADIUS; dx <= LANDMARK_RADIUS; dx++) {
+            for (int dz = -LANDMARK_RADIUS; dz <= LANDMARK_RADIUS; dz++) {
+                for (int dy = -LANDMARK_HEIGHT; dy <= LANDMARK_HEIGHT; dy++) {
+                    pos.setPos(me.getX() + dx, me.getY() + dy, me.getZ() + dz);
+                    net.minecraft.block.Block b = mc.world.getBlockState(pos).getBlock();
+                    if (b == net.minecraft.block.Blocks.AIR) continue;
+                    ResourceLocation rl = Registry.BLOCK.getKey(b);
+                    if (rl == null) continue;
+                    String name = rl.getPath();
+                    boolean hit = false;
+                    for (String suf : LANDMARK_SUFFIXES) { if (name.endsWith(suf)) { hit = true; break; } }
+                    if (!hit) continue;
+                    double d = Math.sqrt(dx * dx + dy * dy + dz * dz);
+                    java.util.List<double[]> l = best.computeIfAbsent(name, k -> new java.util.ArrayList<>());
+                    l.add(new double[]{pos.getX(), pos.getY(), pos.getZ(), d});
+                }
+            }
+        }
+        for (java.util.Map.Entry<String, java.util.List<double[]>> e : best.entrySet()) {
+            java.util.List<double[]> l = e.getValue();
+            l.sort((a, c) -> Double.compare(a[3], c[3]));
+            JsonArray arr = new JsonArray();
+            for (int i = 0; i < Math.min(LANDMARK_KEEP, l.size()); i++) {
+                double[] v = l.get(i);
+                JsonArray p = new JsonArray();
+                p.add((int) v[0]); p.add((int) v[1]); p.add((int) v[2]); p.add(Math.round(v[3] * 10.0) / 10.0);
+                arr.add(p);
+            }
+            JsonObject o = new JsonObject();
+            o.add("nearest", arr);
+            o.addProperty("count", l.size());
+            out.add(e.getKey(), o);
+        }
+        return out;
+    }
