+    // MineEvolve patch: "chat <text>" action lines are sent as chat messages
+    // (so "/gamerule ...", "/setblock ..." etc. reach the integrated server)
+    // instead of being parsed as key presses.
+    private static final String CHAT_VERB = "chat";
+
+    private static void execChatActions(String actions) {
+        Minecraft mc = Minecraft.getInstance();
+        for (String action: actions.split("\n")) {
+            String trimmed = action.trim();
+            if (!trimmed.startsWith(CHAT_VERB + " ")) {
+                continue;
+            }
+            String message = trimmed.substring(CHAT_VERB.length() + 1).trim();
+            if (message.isEmpty()) {
+                continue;
+            }
+            mc.execute(() -> {
+                if (mc.player != null) {
+                    mc.player.sendChatMessage(message);
+                }
+            });
+        }
+    }
